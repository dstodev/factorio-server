# +snip
#
# shellcheck shell=bash
#
# This file is read by script/util/compose.sh::compose_env() to produce a new
# file docker/.env with all Bash expressions evaluated.
#
# Expressions are evaluated in-order by the same subshell. See
# script/util/etc.sh::print_bash_interpreted_file() for implementation.
#
# -snip

# -- Project-declared variables

PROJECT_NAME=servers

USER_ID=$(id --user)
GROUP_ID=$(id --group)

# +snip
PORT_BASE=50000
PORT_BASE_WEBVIEW=$((PORT_BASE + 5980))
# -snip

# Gateway: reverse-proxy to services running on this host.
#
GW_PORT_ADMIN=$((PORT_BASE + 100))
GW_PORT_HTTP=$((PORT_BASE + 80))
GW_PORT_HTTPS=$((PORT_BASE + 443))

# Webview: web-based VNC client to view a server's virtual display.
#
# Prefer small resolutions to reduce bandwidth and CPU usage.
#  1280x720x24  (1280*720=921600)
#  1024x768x16  (1024*768=786432)
#
WEBVIEW_PORT_HOST=$((PORT_BASE_WEBVIEW + $(id --user)))
WEBVIEW_RESOLUTION=1280x720x24

# -- System configuration

TZ=America/Los_Angeles
